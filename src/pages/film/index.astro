---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
const projects = (await getCollection('film', ({ data }) => data.publication === 'published')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<SiteLayout title="Film" theme="film">
  <div class="portfolio-index">
    <header class="portfolio-heading">
      <p class="eyebrow">Selected work</p>
      <h1>Film</h1>
    </header>
    <div class="portfolio-list">
      {projects.map(({ data }, index) => <PortfolioCard title={data.title} href={`/film/projects/${data.url_slug}/`} cover={data.cover} description={data.roles.join(' · ')} eager={index === 0} />)}
    </div>
  </div>
</SiteLayout>
