---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Film & Art" landing>
  <div class="split">
    <a class="world world-film" href="/film/">
      <span class="world-number" aria-hidden="true">01 / FILM</span>
      <span class="world-label">Film</span>
      <span class="world-entry">Enter Film <span aria-hidden="true">↗</span></span>
    </a>
    <a class="world world-art" href="/art/">
      <span class="world-number" aria-hidden="true">02 / ART</span>
      <span class="world-label">Art</span>
      <span class="world-entry">Enter Art <span aria-hidden="true">↗</span></span>
    </a>
    <h1 class="bridge"><span>Two worlds.</span><span>One artist.</span></h1>
  </div>
</SiteLayout>
