---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionDecor from '../components/SectionDecor.astro';
---
<SiteLayout title="Film & Art" landing>
  <div class="split">
    <a class="world world-film" href="/film/">
      <SectionDecor section="film" />
      <span class="world-label">Film <span class="world-arrow" aria-hidden="true">↗</span></span>
    </a>
    <a class="world world-art" href="/art/">
      <SectionDecor section="art" />
      <span class="world-label">Art <span class="world-arrow" aria-hidden="true">↗</span></span>
    </a>
    <h1 class="bridge"><span>Two worlds.</span><span>One artist.</span></h1>
  </div>
</SiteLayout>
