---
import type { DecorationSection } from '../lib/decoration';
import SiteLayout from '../layouts/SiteLayout.astro';
interface Props {
  title: string;
  section: DecorationSection;
  theme?: 'neutral' | 'film' | 'art';
}
const { title, section, theme = 'neutral' } = Astro.props;
---
<SiteLayout title={title} theme={theme} section={section}>
  <section class="page-intro">
    <p class="eyebrow">Portfolio in preparation</p>
    <h1>{title}</h1>
    <p class="page-description"><slot /></p>
    <a class="text-link" href="/">Explore Film &amp; Art <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
