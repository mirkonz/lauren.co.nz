---
<svg class="section-mark" viewBox="0 0 800 600" fill="none" aria-hidden="true" focusable="false">
  <path d={mark.path} fill={mark.filled ? 'currentColor' : 'none'} stroke={mark.filled ? 'none' : 'currentColor'} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  {mark.cutout && <path d={mark.cutout} stroke="var(--mark-cutout)" stroke-width="5" stroke-linecap="round" />}
</svg>
